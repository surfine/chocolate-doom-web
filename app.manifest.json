{
  "id": "doom",
  "version": "1.0.0",
  "protocol": 1,
  "kit": ">=1 <2",
  "windows": [
    {
      "window": "doom",
      "app": "doom",
      "entry": "index.html",
      "titleKey": "doom_title",
      "windowClass": "doom-window openttd-window",
      "paneClass": "doom-pane openttd-pane",
      "frameClass": "doom-frame",
      "statusClass": "doom-details-bar openttd-details-bar",
      "allow": "fullscreen; gamepad",
      "phone": 2,
      "size": {
        "width": "960px",
        "height": "640px"
      },
      "status": {
        "loading": "doom_status_loading",
        "failed": "doom_status_timeout"
      },
      "capabilities": [
        "state",
        "snapshot",
        "wake"
      ],
      "menus": [
        {
          "id": "file",
          "labelKey": "menu_file",
          "items": [
            {
              "type": "item",
              "action": "close-active-window",
              "labelKey": "close",
              "shortcutId": "close-window",
              "conditionId": "close-active-window"
            }
          ]
        }
      ]
    }
  ],
